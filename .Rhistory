#Librerias utilizadas
library(nycflights13)
library(dplyr)
library(ggplot2)
library(tidyr)
library(lubridate)
tasa_cancelacion <- mean(vuelos_limpios$cancelado)*100
#Librerias utilizadas
library(nycflights13)
library(dplyr)
library(ggplot2)
library(tidyr)
library(lubridate)
vuelos_limpios %>%
group_by(month) %>%
summarise(tasa_cancelacion <- mean(vuelos_limpios$cancelado)*100) %>%
ggplot(aes( x = month, y = tasa_cancelacion)) +
geom_col( fill = "lightblue") +
labs(
title = "Tasa de cancelación por mes",
x = "Mes",
y = "Porcentaje de cancelación"
) +
theme_minimal()
