#Librerias utilizadas
library(nycflights13)
library(dplyr)
library(ggplot2)
library(tidyr)
library(lubridate)
vuelos_mensuales <- vuelos_analisis %>%
group_by(month, origin) %>%
summarise(n_vuelos = n(), .groups = "drop")
ggplot(vuelos_mensuales, aes(x = month, y = n_vuelos, color = origin)) +
geom_line(size = 1) +
geom_point() +
labs(title = "Vuelos mensuales por aeropuerto de origen",
x = "Mes", y = "Número de vuelos")
