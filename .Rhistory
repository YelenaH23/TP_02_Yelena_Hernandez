#Librerias utilizadas
library(nycflights13)
library(dplyr)
library(ggplot2)
library(tidyr)
library(lubridate)
boxplot(arr_delay~origin, data = vuelos_limpios,
main = " Retraso de llegada por aeropuerto de origen",
xlab = "Aeropuerto de origen",
ylab = "Retraso de llegada")
#Librerias utilizadas
library(nycflights13)
library(dplyr)
library(ggplot2)
library(tidyr)
library(lubridate)
vuelos_analisis %>%
filter(
!is.na(wind_speed),
!is.na(dep_delay)
) %>%
ggplot(
aes(
x = wind_speed,
y = dep_delay
)
) +
geom_point(alpha = 0.3) +
geom_smooth(method = "lm", se = FALSE) +
labs(
title = "Velocidad del viento y retraso de salida",
x = "Velocidad del viento",
y = "Retraso de salida (minutos)"
) +
theme_minimal()
