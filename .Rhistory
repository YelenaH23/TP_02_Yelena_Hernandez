#Librerias utilizadas
library(nycflights13)
library(dplyr)
library(ggplot2)
library(tidyr)
library(lubridate)
flights2 <- flights %>%
mutate( fecha = as.Date( paste(year, month, day, sep = "-")
))
flights2 <- flights2 %>%
mutate(cancelado = is.na(dep_time))
flights2 <- flights2 %>%
mutate( retraso_llegada =  if_else(
arr_delay > 15, TRUE, FALSE, missing = NA))
