library(nycflights13)
library(dplyr)
library(ggplot2)
library(tidyr)
library(lubridate)
flights %>%
summarise(
dep_time_na = sum(is.na(dep_time)),
dep_delay_na = sum(is.na(dep_delay)),
arr_time_na = sum(is.na(arr_time)),
arr_delay_na = sum(is.na(arr_delay)),
tailnum_na = sum(is.na(tailnum)))
flights %>%
summarise(
dep_time_pct = mean(is.na(dep_time)) * 100,
dep_delay_pct = mean(is.na(dep_delay)) * 100,
arr_time_pct = mean(is.na(arr_time)) * 100,
arr_delay_pct = mean(is.na(arr_delay)) * 100,
tailnum_pct = mean(is.na(tailnum)) * 100)
