data("flights")
data("airlines")
data("airports")
data("planes")
data("weather")
force(airlines)
View(airlines)
force(airports)
View(airports)
force(flights)
View(flights)
force(planes)
force(weather)
View(planes)
View(weather)
vuelos_mensuales <- vuelos_analisis %>%
group_by(month, origin) %>%
summarise(n_vuelos = n(), .groups = "drop")
filas_inicial <- nrow(flights)
cat("Filas iniciales:", filas_inicial, "\n")
# Unión con aerolíneas
vuelos_analisis <- flights %>%
left_join(airlines, by = "carrier")
cat("Después de airlines:", nrow(vuelos_analisis), "\n")
# Unión con aeropuertos destino
vuelos_analisis <- vuelos_analisis %>%
left_join(airports %>% select(faa, name_dest = name, lat_dest = lat, lon_dest = lon),
by = c("dest" = "faa"))
cat("Después de airports:", nrow(vuelos_analisis), "\n")
# Unión con aeronaves
vuelos_analisis <- vuelos_analisis %>%
left_join(planes %>% select(tailnum, year_fab = year, type, manufacturer, model, engines, seats),
by = "tailnum")
cat("Después de planes:", nrow(vuelos_analisis), "\n")
# Unión con clima
vuelos_analisis <- vuelos_analisis %>%
left_join(weather, by = c("origin", "time_hour"))
cat("Después de weather:", nrow(vuelos_analisis), "\n")
vuelos_mensuales <- vuelos_analisis %>%
group_by(month, origin) %>%
summarise(n_vuelos = n(), .groups = "drop")
