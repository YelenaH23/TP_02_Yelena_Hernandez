dataset = c("flights", "airlines", "airports", "planes", "weather"),
filas = c(
nrow(flights),
nrow(airlines),
nrow(airports),
nrow(planes),
nrow(weather)),
columnas = c(
ncol(flights),
ncol(airlines),
ncol(airports),
ncol(planes),
ncol(weather)))
resumen
